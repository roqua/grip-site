---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blocks } from '../components/mdx-components';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.mdx');

const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  crumbs={[{ label: entry.data.crumb ?? entry.data.title }]}
>
  <Content components={blocks} />
</BaseLayout>
